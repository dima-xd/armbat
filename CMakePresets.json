{
  "version": 6,
  "configurePresets": [
    {
      "name": "arm64",
      "displayName": "Android arm64-v8a (Release)",
      "description": "NDK r29, arm64-v8a, static libc++ so pushed binaries stay self-contained",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_ROOT}/build/cmake/android.toolchain.cmake",
        "CMAKE_MAKE_PROGRAM": "$env{ARMBAT_NINJA}",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-31",
        "ANDROID_STL": "c++_static",
        "ANDROID_ARM_NEON": "ON",
        "ARMBAT_GUEST_RUNTIME_BIONIC": "ON",
        "ARMBAT_VERSION_NAME": "0.0.0-dev",
        "ARMBAT_VERSION_CODE": "0"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "arm64",
      "configurePreset": "arm64",
      "jobs": 8
    }
  ]
}
